# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://username:password@cluster0.mongodb.net/derbybet?retryWrites=true&w=majority
# Or Local: mongodb://localhost:27017/derbybet
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/derbybet?retryWrites=true&w=majority"

# Server Port (default: 3005)
PORT=3005

# Optional Gemini API Key
GEMINI_API_KEY=""
